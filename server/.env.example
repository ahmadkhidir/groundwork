# Groundwork API service configuration.
# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# --- Required ---------------------------------------------------------------
# Postgres connection. Matches docker-compose.yml for local development.
DATABASE_URL=postgres://groundwork:groundwork@localhost:5432/groundwork?sslmode=disable

# Must be IDENTICAL to web/.env.local's AUTH_SECRET. The Go service decodes the Auth.js session
# cookie the browser sends directly to it (internal/authsession) rather than trusting the client —
# see architecture.md's Authentication & Authorization section ("enforced on every request by the Go
# API Service"). A mismatch here means every request from a signed-in browser is rejected as
# unauthenticated.
AUTH_SECRET=dev-only-local-secret-not-for-production

# --- Server -----------------------------------------------------------------
PORT=8080
ENVIRONMENT=development
# The web client's origin, for CORS. Never "*": credentials ride on every request.
ALLOWED_ORIGIN=http://localhost:3000

# --- Thresholds -------------------------------------------------------------
# Per-file upload ceiling in bytes. Default 500 MB (confirmed 2026-08-05).
# Must stay in step with NEXT_PUBLIC_MAX_UPLOAD_BYTES in web/.env.local.
MAX_UPLOAD_BYTES=524288000
# How long an engine may idle before teardown.
ENGINE_IDLE_TIMEOUT=10m
# How often the background metering reconciliation refreshes every workspace's storage_bytes
# snapshot (billing milestone). Default 24h.
USAGE_RECONCILE_INTERVAL=24h

# --- Object storage (MinIO locally, Cloudflare R2 in production) -------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=groundwork-datasets
S3_ACCESS_KEY_ID=groundwork
S3_SECRET_ACCESS_KEY=groundwork-secret
S3_REGION=auto

# --- Model provider ---------------------------------------------------------
# Every payload sent to this provider is written to the audit/egress log in the
# same code path as the outbound call.
ANTHROPIC_API_KEY=

# --- Transactional email (password reset delivery) --------------------------
# SMTP is the provider-agnostic interface: any transactional email provider's SMTP
# credentials configure this. When SMTP_HOST is empty (default), delivery is disabled
# and the reset token is written to the structured log line instead — an operator
# relays it manually. architecture.md's email-provider decision is therefore a config
# value, not code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From address reset mail is sent as, e.g. "Groundwork <no-reply@example.com>".
EMAIL_FROM=
# The web origin reset links point at. Defaults to ALLOWED_ORIGIN (the web origin).
# WEB_BASE_URL=https://app.example.com

# --- Stripe (billing milestone, test-mode first) ----------------------------
# Get test keys from https://dashboard.stripe.com/test/apikeys — secret key starts with sk_test_.
# The web tier uses the publishable key (pk_test_) — see web/.env.example's NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret for verifying webhook events. Created when you add a webhook endpoint in the Stripe
# dashboard (or via `stripe listen --forward-to localhost:8080/v1/billing/webhook`), and starts with
# whsec_. This MUST be the secret for the test-mode webhook, not the live one.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe Price IDs for the three plans, created in the Stripe dashboard under Products → Prices
# (test mode). One-time `price_...` IDs (or recurring Price IDs) — Pass 2 wires these into
# Checkout. Keep the monthly variants unless annual is configured.
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_TEAM=price_xxx
# Optional: route webhook events to a local CLI instead of a public HTTPS endpoint in dev.
# STRIPE_WEBHOOK_FORWARD_URL=http://localhost:8080/v1/billing/webhook
