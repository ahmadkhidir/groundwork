# Groundwork API service configuration.
# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# --- Required ---------------------------------------------------------------
# Postgres connection. Matches docker-compose.yml for local development.
DATABASE_URL=postgres://groundwork:groundwork@localhost:5432/groundwork?sslmode=disable

# --- Server -----------------------------------------------------------------
PORT=8080
ENVIRONMENT=development
# The web client's origin, for CORS. Never "*": credentials ride on every request.
ALLOWED_ORIGIN=http://localhost:3000

# --- Thresholds -------------------------------------------------------------
# Per-file upload ceiling in bytes. Default 500 MB (confirmed 2026-08-05).
# Must stay in step with NEXT_PUBLIC_MAX_UPLOAD_BYTES in web/.env.local.
MAX_UPLOAD_BYTES=524288000
# How long an engine may idle before teardown.
ENGINE_IDLE_TIMEOUT=10m

# --- Object storage (MinIO locally, Cloudflare R2 in production) -------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=groundwork-datasets
S3_ACCESS_KEY_ID=groundwork
S3_SECRET_ACCESS_KEY=groundwork-secret
S3_REGION=auto

# --- Model provider ---------------------------------------------------------
# Every payload sent to this provider is written to the audit/egress log in the
# same code path as the outbound call.
ANTHROPIC_API_KEY=
