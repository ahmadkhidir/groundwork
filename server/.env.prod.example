# Production secrets for the Fly API app (groundwork-api).
#
# Copy this file to `.env.prod` (gitignored — NEVER commit it), fill in the real values, then run
# `make secrets-prod` in server/ to import them into Fly. The import reads KEY=VALUE lines
# verbatim (one pair per line, value = everything after the first `=`).
#
# The values below are placeholders. Do not use them for anything real.
AUTH_SECRET=replace-with-openssl-rand-base64-32-same-value-as-vercel
DATABASE_URL=postgres://user:pass@host.neon.tech/groundwork?sslmode=require
S3_ENDPOINT=https://<r2-account-id>.r2.cloudflarestorage.com
S3_BUCKET=groundwork-datasets
S3_ACCESS_KEY_ID=replace-with-r2-access-key
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-key
S3_REGION=auto
ANTHROPIC_API_KEY=sk-ant-replace-me
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_TEAM=price_replace_me
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=Groundwork <no-reply@example.com>
